#!/usr/bin/env bash
# The repository's checks as main's CI runs them. `bash check changed`
# tests only the packages the change since main reaches, without the race
# detector, as pr.yml does: an agent runs it before it ends.
# `bash check test <suite> [<name>]` runs one suite, or the one named test
# in it, beside a throwaway Postgres, and writes a JUnit report to
# `$CHECK_REPORT`: the criteria gate's runner reads it.
# `bash check static` stops before the tests: the pre-push hook's gate
# (.githooks/pre-push). gosec is the runner image's
# version. govulncheck stays CI's: it reads the runner image's copy of
# its database, which no sandbox or clone holds, and a finding reaches
# the agent as the failing job's log lines.
set -euo pipefail
cd "$(dirname "$0")"

# One check at a time per checkout: three beside each other passed a
# sandbox's 4Gi and the OOM kill took the session's unpushed work.
lock=${TMPDIR:-/tmp}/check-$(pwd -P | cksum | cut -d" " -f1).lock
if [ "${CHECK_LOCK:-}" != "$lock" ]; then
  code=0
  CHECK_LOCK=$lock flock -n -o -E 75 "$lock" bash "./$(basename "$0")" "$@" || code=$?
  if [ "$code" = 75 ]; then
    echo "another bash check (pid $(cat "$lock")) runs in this checkout: wait for it to end, then run this one again" >&2
    exit 1
  fi
  exit "$code"
fi
echo $$ >"$lock"

if [ "${1:-}" = test ]; then
  : "${2:?usage: bash check test <suite> [<name>]}" "${CHECK_REPORT:?bash check test writes its JUnit report to the file CHECK_REPORT names}"
  run=(go run gotest.tools/gotestsum@v1.13.0 --junitfile "$CHECK_REPORT" -- -count=1)
  [ -n "${3:-}" ] && run+=(-run "^${3//\//\$/^}\$")
  exec scripts/pg-test.sh "${run[@]}" "$2"
fi
go vet ./...
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then echo "gofmt -w these files:"; echo "$unformatted"; exit 1; fi
go run "github.com/securego/gosec/v2/cmd/gosec@v$(sed -n 's/^ARG GOSEC_VERSION=//p' Dockerfile.runner)" -quiet ./...
[ "${1:-}" = static ] && exit 0
if [ "${1:-}" = changed ]; then
  base=$(git merge-base HEAD refs/remotes/origin/HEAD) || {
    echo "bash check changed tests the change since origin/HEAD, which this clone lacks: run git remote set-head origin --auto, or bash check" >&2
    exit 1
  }
  pkgs=$(scripts/affected-packages.sh "$base")
  # two packages at once in a sandbox's 4Gi
  scripts/pg-test.sh go test -p 2 $pkgs
  exit
fi
make test
