FROM golang:1.25-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/agent-worker ./cmd/agent-worker

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
LABEL org.opencontainers.image.source=https://git.aisoftwarefactory.world/sf/ai-software-factory-code
ARG OPENCODE_VERSION=v1.18.32
RUN DEBIAN_FRONTEND=noninteractive apt-get update \
      && apt-get install -y --no-install-recommends git ca-certificates tzdata curl ripgrep \
      && rm -rf /var/lib/apt/lists/* \
      && useradd -m -u 1000 -s /bin/bash worker
# release asset arch is "x64", not "amd64"; remote ADD does not auto-extract
ADD https://github.com/anomalyco/opencode/releases/download/${OPENCODE_VERSION}/opencode-linux-x64.tar.gz /tmp/opencode.tar.gz
RUN echo "3046e0404fdc60fb80307e7a47824ba07477364178a4d09baa8548496dd6d43b  /tmp/opencode.tar.gz" | sha256sum -c - \
      && tar -xzf /tmp/opencode.tar.gz -C /tmp opencode \
      && install -m 0755 /tmp/opencode /usr/local/bin/opencode \
      && rm /tmp/opencode.tar.gz /tmp/opencode
COPY --from=build /out/agent-worker /usr/local/bin/agent-worker
# Pre-bake the npm provider so a running sandbox never needs registry.npmjs.org
# (egress stays off the CNP allowlist). HOME here is NOT the runtime HOME —
# the pod mounts an emptyDir over /home/worker, so the worker copies this
# bake into place at start. The dead baseURL makes opencode fail after the
# install, which is all this step needs.
RUN mkdir -p /opt/opencode-home \
      && chown -R 1000:1000 /opt/opencode-home \
      && HOME=/opt/opencode-home OPENCODE_CONFIG_CONTENT='{"provider":{"factory":{"npm":"@ai-sdk/openai-compatible","name":"Factory gateway","options":{"baseURL":"http://127.0.0.1:9/v1","apiKey":"sandbox-dummy"},"models":{"bake":{"name":"Factory model","reasoning":true,"interleaved":{"field":"reasoning_content"},"limit":{"context":200000,"output":1000}}}}}}' \
         timeout 300 opencode run --format json --model factory/bake "warm the provider cache" || true
USER 1000:1000
# every one of these phones home past the egress allowlist and stalls on the drop;
# ripgrep is installed because opencode otherwise downloads it from GitHub
ENV HOME=/home/worker \
    OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_DISABLE_MODELS_FETCH=1 \
    OPENCODE_DISABLE_LSP_DOWNLOAD=1
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/opencode"]
