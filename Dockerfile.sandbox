ARG OPENCODE_VERSION=v1.18.32
ARG NODE_VERSION=24.21.0

# Every outside image comes from the factory's store by the digest
# upstream-images.txt pins (roadmap 203). A build with no login to the
# store (a local one) passes UPSTREAM= and pulls the same digests from
# their upstreams.
ARG UPSTREAM=git.aisoftwarefactory.world/upstream/

# The archives the image unpacks, each read from the factory's store
# (roadmap 203, step 2): the generic package its line of
# upstream-files.txt fills, at the sha256 the line pins — no build
# reaches the line's upstream. The image's steps mount this stage, so no
# layer of the image keeps an archive. opencode's release asset arch is
# "x64", not "amd64".
FROM scratch AS downloads
ARG OPENCODE_VERSION
ARG NODE_VERSION
ADD --checksum=sha256:3046e0404fdc60fb80307e7a47824ba07477364178a4d09baa8548496dd6d43b https://git.aisoftwarefactory.world/api/packages/upstream/generic/opencode/${OPENCODE_VERSION}/opencode-linux-x64.tar.gz /opencode.tar.gz
ADD --checksum=sha256:fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6 https://git.aisoftwarefactory.world/api/packages/upstream/generic/node/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz /node.tar.xz

FROM ${UPSTREAM}docker.io/library/golang:1.26.9-alpine@sha256:397ecc648150dd585f1734dfcd8d1bb4746664e54464191d77ad0ecffaf38bdb AS build
# roadmap 232: this stage's only clock is the commit's; ci.yml passes
# --build-arg SOURCE_DATE_EPOCH=<commit time> so a content-identical tree
# builds the same digest at any wall-clock time. The stage builds offline
# (roadmap 203, step 2): its module cache is the store's go-modules
# tarball of this go.sum, restored below in the GOPROXY file layout
# scripts/upstream-files uploads; GOPROXY=off leaves no fallback, so a
# missing or wrong store copy fails the build and go.sum stays the
# content pin, and GOFLAGS=-mod=mod keeps the download a read of the
# cache, not a rewrite of go.mod.
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH \
    GOPROXY=off \
    GOFLAGS=-mod=mod
WORKDIR /src
COPY go.mod go.sum ./
# Go telemetry off before the first go call: its counter files carry the
# build's date, and `go telemetry off` would date its mode file too; an
# undated "off" is the same mode.
RUN mkdir -p "$HOME/.config/go/telemetry" && printf off > "$HOME/.config/go/telemetry/mode" \
      && sum=$(sha256sum go.sum | awk '{print $1}') \
      && i=0 && until wget -T 60 -O /tmp/go-modules.tar.gz "https://git.aisoftwarefactory.world/api/packages/upstream/generic/go-modules/$sum/go-modules.tar.gz"; do \
           i=$((i+1)); [ "$i" -lt 5 ] || { echo "go-modules: the store did not answer in five tries" >&2; exit 1; }; \
           echo "go-modules: retry $i after a failed fetch"; sleep $((i * 10)); \
         done \
      && mkdir -p "$(go env GOMODCACHE)/cache/download" \
      && tar -C "$(go env GOMODCACHE)/cache/download" -xzf /tmp/go-modules.tar.gz \
      && rm /tmp/go-modules.tar.gz \
      && go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/agent-worker ./cmd/agent-worker

# The store's npm cache of the opencode plugin lockfile (roadmap 203,
# step 2): package npm-cache, version the lockfile's sha256, its _cacache
# the tarball holds — what scripts/upstream-files uploaded. The node base
# image below ships no downloader, so the store's golang copy fetches it
# with busybox wget; a 404 fails the build, no upstream answers. The two
# bare wgets of this image (this one and the build stage's go-modules
# fetch) are its only network reads without a retry — apt above retries
# eight times — and busybox wget has none of its own, so a single store
# blip failed the build outright: main run 1620's image-sandbox went red
# on sandbox inputs identical to the green run before it (1bec5978 changed
# k8s pins only), the class of fault five bounded retries rule out.
FROM ${UPSTREAM}docker.io/library/golang:1.26.9-alpine@sha256:397ecc648150dd585f1734dfcd8d1bb4746664e54464191d77ad0ecffaf38bdb AS npm-cache
COPY opencode-plugin/package-lock.json /tmp/package-lock.json
RUN sum=$(sha256sum /tmp/package-lock.json | awk '{print $1}') \
      && i=0 && until wget -T 60 -O /tmp/npm-cache.tar.gz "https://git.aisoftwarefactory.world/api/packages/upstream/generic/npm-cache/$sum/npm-cache.tar.gz"; do \
           i=$((i+1)); [ "$i" -lt 5 ] || { echo "npm-cache: the store did not answer in five tries" >&2; exit 1; }; \
           echo "npm-cache: retry $i after a failed fetch"; sleep $((i * 10)); \
         done \
      && mkdir -p /npm-cache \
      && tar -C /npm-cache -xzf /tmp/npm-cache.tar.gz

# opencode's first run npm-installs @opencode-ai/plugin (pinned to its own
# version) into $HOME/.config/opencode if that directory is empty -- proven
# by direct reproduction: a cold HOME on a reachable network installs it in
# ~65s; on no network at all it is silently skipped, not fast-failed. The
# sandbox reaches registry.npmjs.org (for the project's npm scripts), so a
# live first run would spend those 65s of the session installing; the bake
# below fills the directory first, so it never does. package.json and
# package-lock.json here are opencode's own self-installed lockfile, copied
# verbatim, so `npm ci` reproduces byte-for-byte what opencode would install
# itself, pinned at build time rather than resolved by a session. The cache
# comes from the store, and npm ci runs --offline against it (roadmap 203,
# step 2): a missing or wrong store copy fails the install.
FROM ${UPSTREAM}docker.io/library/node:22-bookworm-slim@sha256:25330af3531fb5e23318554a0aa911125b6e91b1b777edf7655501d207c067a2 AS opencode-plugin
ARG OPENCODE_VERSION
WORKDIR /opencode-home/.config/opencode
COPY opencode-plugin/package.json opencode-plugin/package-lock.json ./
COPY --from=npm-cache /npm-cache /npm-cache
RUN npm ci --offline --cache /npm-cache --no-audit --no-fund \
      && test "$(node -p "require('./node_modules/@opencode-ai/plugin/package.json').version")" = "${OPENCODE_VERSION#v}"

# The sandbox without the harness and the stack, pushed as sf/sandbox-base:
# project images build FROM it and apt-get install from its sources.
FROM ${UPSTREAM}docker.io/library/debian:bookworm-slim@sha256:f3034a6ec3c1205360777c4aae76234998866ad18806ae62b63a3f84ccad782b AS base
LABEL org.opencontainers.image.source=https://git.aisoftwarefactory.world/sf/ai-software-factory-code
# useradd dates the worker's /etc/shadow entry by SOURCE_DATE_EPOCH, else
# by the build's day.
ARG SOURCE_DATE_EPOCH
ARG DEBIAN_SNAPSHOT=20261015T000000Z
ARG POSTGRESQL_VERSION=17.11-1.pgdg12+2
ARG LIBPQ_VERSION=18.6-1.pgdg12+2
ARG POSTGRESQL_COMMON_VERSION=293.pgdg12+1
# Debian's packages come from snapshot.debian.org at DEBIAN_SNAPSHOT, and
# PostgreSQL 17's server for scripts/pg-test.sh from the PGDG archive at the
# versions named, as in Dockerfile.runner, which says why. The install
# creates no cluster.
# The install's clocks go with it: ssl-cert (postgresql-common depends on
# it; scripts/pg-test.sh runs its server without TLS) generates a random
# snakeoil pair, and ldconfig's aux-cache and the apt, dpkg and
# alternatives logs carry the build's time.
# The PGDG signing key, the store's copy of its line of
# upstream-files.txt (roadmap 203, step 2) at the line's sha256.
ADD --checksum=sha256:0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76 https://git.aisoftwarefactory.world/api/packages/upstream/generic/pgdg-key/ACCC4CF8/ACCC4CF8.asc /etc/apt/keyrings/pgdg.asc
RUN chmod 0644 /etc/apt/keyrings/pgdg.asc \
      && printf '%s\n' 'Acquire::Retries "8";' 'Acquire::http::Timeout "60";' 'Acquire::https::Timeout "60";' 'Acquire::Check-Valid-Until "false";' \
           > /etc/apt/apt.conf.d/80snapshot \
      && rm /etc/apt/sources.list.d/debian.sources \
      && printf '%s\n' "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" \
           "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-updates main" \
           "deb http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main" > /etc/apt/sources.list \
      && printf '%s\n' 'Package: *' 'Pin: origin apt-archive.postgresql.org' 'Pin-Priority: 1' > /etc/apt/preferences.d/pgdg-archive \
      && mkdir -p /etc/postgresql-common/createcluster.d \
      && echo "create_main_cluster = false" > /etc/postgresql-common/createcluster.d/no-main-cluster.conf \
      && DEBIAN_FRONTEND=noninteractive apt-get update \
      && apt-get install -y --no-install-recommends ca-certificates \
      && echo "deb [signed-by=/etc/apt/keyrings/pgdg.asc,B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8] https://apt-archive.postgresql.org/pub/repos/apt bookworm-pgdg-archive main" \
           > /etc/apt/sources.list.d/pgdg.list \
      && apt-get update \
      && apt-get install -y --no-install-recommends git ca-certificates tzdata curl ripgrep openssh-client xz-utils \
           gcc libc6-dev make python3 \
           postgresql-17=${POSTGRESQL_VERSION} postgresql-client-17=${POSTGRESQL_VERSION} libpq5=${LIBPQ_VERSION} \
           postgresql-common=${POSTGRESQL_COMMON_VERSION} postgresql-client-common=${POSTGRESQL_COMMON_VERSION} \
      && rm -rf /var/lib/apt/lists/* \
      && useradd -m -u 1000 -s /bin/bash worker \
      && rm /etc/ssl/certs/ssl-cert-snakeoil.pem /etc/ssl/private/ssl-cert-snakeoil.key /var/cache/ldconfig/aux-cache \
           /var/log/alternatives.log /var/log/apt/history.log /var/log/apt/term.log /var/log/dpkg.log
USER 1000:1000
ENV HOME=/home/worker
WORKDIR /workspace

FROM base
# the commit's clock reaches this stage's steps too, as the base's
ARG SOURCE_DATE_EPOCH
USER root
RUN --mount=type=bind,from=downloads,source=/opencode.tar.gz,target=/tmp/opencode.tar.gz \
      tar -xzf /tmp/opencode.tar.gz -C /tmp opencode \
      && install -m 0755 /tmp/opencode /usr/local/bin/opencode \
      && rm /tmp/opencode
# Go toolchain (ruling 99), the same pin as Dockerfile.runner, so the agent
# can run the tests the PR checks will run: taken from the pinned golang base
# image stage instead of go.dev/dl, which redirects to dl.google.com and that
# host is unreachable here.
COPY --from=build /usr/local/go /usr/local/go
# Node 24 (the active LTS line), npm with it: the project checks run npm
# scripts.
RUN --mount=type=bind,from=downloads,source=/node.tar.xz,target=/tmp/node.tar.xz \
      tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
      && node --version && npm --version \
      && rm -r /tmp/node-compile-cache
COPY --from=build /out/agent-worker /usr/local/bin/agent-worker
# Pre-baked opencode provider packages (see the opencode-plugin stage above).
# The pod's harness init container copies them out with the two binaries,
# and the worker into the emptyDir the pod mounts over /home/worker.
COPY --from=opencode-plugin --chown=1000:1000 /opencode-home/.config/opencode /opt/opencode-home/.config/opencode
USER 1000:1000
# every one of these phones home past the egress allowlist and stalls on the drop;
# ripgrep is installed because opencode otherwise downloads it from GitHub.
# GOTOOLCHAIN=local: go never fetches another toolchain; GOPROXY without the
# "direct" fallback: only the module proxy is reachable, a fallback would
# hang on the drop.
ENV OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_DISABLE_MODELS_FETCH=1 \
    OPENCODE_DISABLE_LSP_DOWNLOAD=1 \
    PATH=/usr/local/go/bin:/home/worker/go/bin:$PATH \
    GOTOOLCHAIN=local \
    GOPROXY=https://proxy.golang.org \
    GOSUMDB=sum.golang.org
# Go telemetry off before the first go call, as in the build stage.
RUN mkdir -p "$HOME/.config/go/telemetry" && printf off > "$HOME/.config/go/telemetry/mode" && /usr/local/go/bin/go version
ENTRYPOINT ["/usr/local/bin/opencode"]
