FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
LABEL org.opencontainers.image.source=https://git.aisoftwarefactory.world/sf/ai-software-factory-code
# Task 41 (ruling 78/89/90/91): the untrusted PR runner. Host executor inside
# an unprivileged, gVisor-isolated pod — no docker CLI, no socket, no
# registry or repository credential baked in or mounted. Everything a
# pull_request job needs (a Go + C toolchain — go test -race needs cgo, git,
# node for JS actions, buildctl to drive the separate buildkitd build pod)
# ships pre-installed so the job itself never has to reach past the egress
# allowlist for tooling. This same image also runs, unmodified, as the
# sandbox-root buildkitd build pod (ruling 91): see internal/factoryd/ci.go.
ARG FORGEJO_RUNNER_VERSION=13.2.0
ARG BUILDKIT_VERSION=0.33.0
ARG RUNC_VERSION=1.2.5
ARG GO_VERSION=1.25.9
ARG GOSEC_VERSION=2.29.0

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
      && apt-get install -y --no-install-recommends \
           git bash nodejs curl tar ca-certificates gcc libc6-dev \
      && rm -rf /var/lib/apt/lists/* \
      && useradd -m -u 1000 -s /bin/bash runner

# forgejo-runner: single static binary, no extraction.
ADD https://code.forgejo.org/forgejo/runner/releases/download/v${FORGEJO_RUNNER_VERSION}/forgejo-runner-${FORGEJO_RUNNER_VERSION}-linux-amd64 /usr/local/bin/forgejo-runner
RUN echo "fadaec897f5e6641c363f87ecaf75f866f99c81b7097ec6b433e4c48123fcad1  /usr/local/bin/forgejo-runner" | sha256sum -c - \
      && chmod 0755 /usr/local/bin/forgejo-runner

# BuildKit: buildctl + buildkitd (design decision #3); no docker CLI, no
# dockerd. Rootless buildkitd never comes up under gVisor's systrap platform
# (task-41-report.md, design decision #4, and research-stage6-buildkit-gvisor
# in the build-plan ledger) — ruling 91 instead runs buildkitd as sandbox
# root in its own build pod, inside a nested `unshare --user --mount` with a
# wide uid/gid map, the native (copy-based) snapshotter and
# --oci-worker-no-process-sandbox; see internal/factoryd/ci.go. runc below is
# that worker's OCI runtime (this image ships none by default).
ADD https://github.com/moby/buildkit/releases/download/v${BUILDKIT_VERSION}/buildkit-v${BUILDKIT_VERSION}.linux-amd64.tar.gz /tmp/buildkit.tar.gz
RUN echo "b6242896d343100808dcbe37565caf381e0a444a6a83d7255926bb1519248ead  /tmp/buildkit.tar.gz" | sha256sum -c - \
      && tar -xzf /tmp/buildkit.tar.gz -C /usr/local bin/buildctl bin/buildkitd \
      && rm /tmp/buildkit.tar.gz

ADD https://github.com/opencontainers/runc/releases/download/v${RUNC_VERSION}/runc.amd64 /usr/local/bin/runc
RUN echo "fbd851fce6a8e0d67a9d184ea544c2abf67c9fd29b80fcc1adf67dfe9eb036a1  /usr/local/bin/runc" | sha256sum -c - \
      && chmod 0755 /usr/local/bin/runc

# Go 1.25 toolchain, pre-installed so a job never downloads it mid-run.
ADD https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz /tmp/go.tar.gz
RUN echo "00859d7bd6defe8bf84d9db9e57b9a4467b2887c18cd93ae7460e713db774bc1  /tmp/go.tar.gz" | sha256sum -c - \
      && tar -xzf /tmp/go.tar.gz -C /usr/local \
      && rm /tmp/go.tar.gz

# gosec: pr.yml's static security scan (design decision #6 — chosen over
# govulncheck so the job's egress allowlist never needs vuln.go.dev).
ADD https://github.com/securego/gosec/releases/download/v${GOSEC_VERSION}/gosec_${GOSEC_VERSION}_linux_amd64.tar.gz /tmp/gosec.tar.gz
RUN echo "6431b119741c1f4a50fdfcf94e782e16b9e642afc8c7fa9b5d39d48bf3003095  /tmp/gosec.tar.gz" | sha256sum -c - \
      && tar -xzf /tmp/gosec.tar.gz -C /usr/local/bin gosec \
      && rm /tmp/gosec.tar.gz

ENV PATH=/usr/local/go/bin:/home/runner/go/bin:$PATH \
    HOME=/home/runner \
    GOPATH=/home/runner/go
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["forgejo-runner"]
