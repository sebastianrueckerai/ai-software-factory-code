ARG FORGEJO_RUNNER_VERSION=13.2.0
ARG BUILDKIT_VERSION=0.33.0
ARG NODE_VERSION=24.21.0
ARG GOSEC_VERSION=2.29.0
ARG CRANE_VERSION=0.22.1

FROM golang:1.26.9@sha256:37cfcca63222ec499bec5e8ad7aad52dbf7529db36d5812b8eae2f0621aa92d6 AS go-toolchain

# The archives the image unpacks, each checked against its sha256 before
# a layer holds it. The image's steps mount this stage, so no layer of the
# image keeps an archive. Node's sum is the tarball's line in nodejs.org's
# signed SHASUMS256.txt for its version.
FROM scratch AS downloads
ARG BUILDKIT_VERSION
ARG CRANE_VERSION
ARG NODE_VERSION
ARG GOSEC_VERSION
ADD --checksum=sha256:b6242896d343100808dcbe37565caf381e0a444a6a83d7255926bb1519248ead https://github.com/moby/buildkit/releases/download/v${BUILDKIT_VERSION}/buildkit-v${BUILDKIT_VERSION}.linux-amd64.tar.gz /buildkit.tar.gz
ADD --checksum=sha256:0ab7a1d6932a213aed964ce97666c3077fe691c8606413674a8b3e0b9ec4cda0 https://github.com/google/go-containerregistry/releases/download/v${CRANE_VERSION}/go-containerregistry_Linux_x86_64.tar.gz /crane.tar.gz
ADD --checksum=sha256:fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6 https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz /node.tar.xz
ADD --checksum=sha256:6431b119741c1f4a50fdfcf94e782e16b9e642afc8c7fa9b5d39d48bf3003095 https://github.com/securego/gosec/releases/download/v${GOSEC_VERSION}/gosec_${GOSEC_VERSION}_linux_amd64.tar.gz /gosec.tar.gz

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
LABEL org.opencontainers.image.source=https://git.aisoftwarefactory.world/sf/ai-software-factory-code
# Task 41 (ruling 78/89/90): the untrusted PR runner. Host executor inside
# an unprivileged, gVisor-isolated pod — no docker CLI, no socket, no
# registry or repository credential baked in or mounted. Everything a
# pull_request job needs (a Go + C toolchain — go test -race needs cgo, git,
# Node for JS actions and npm, buildctl to drive the job's build VM, crane to read
# the build cache) ships
# pre-installed so the job itself never has to reach past the egress
# allowlist for tooling.
ARG FORGEJO_RUNNER_VERSION
# roadmap 232: the warm-cache go build below runs on the commit's clock, not
# the build clock (ci.yml passes --build-arg SOURCE_DATE_EPOCH=<commit time>).
ARG SOURCE_DATE_EPOCH

# PostgreSQL 17's server for scripts/pg-test.sh, from the PGDG repository:
# apt takes its packages only signed by the key of this fingerprint, and the
# install creates no cluster.
# The install's clocks go with it: ssl-cert (postgresql-common depends on
# it; scripts/pg-test.sh runs its server without TLS) generates a random
# snakeoil pair, and ldconfig's aux-cache and the apt, dpkg and
# alternatives logs carry the build's time.
ADD --checksum=sha256:0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76 https://www.postgresql.org/media/keys/ACCC4CF8.asc /etc/apt/keyrings/pgdg.asc
RUN chmod 0644 /etc/apt/keyrings/pgdg.asc \
      && echo "deb [signed-by=/etc/apt/keyrings/pgdg.asc,B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
           > /etc/apt/sources.list.d/pgdg.list \
      && mkdir -p /etc/postgresql-common/createcluster.d \
      && echo "create_main_cluster = false" > /etc/postgresql-common/createcluster.d/no-main-cluster.conf \
      && DEBIAN_FRONTEND=noninteractive apt-get update \
      && apt-get install -y --no-install-recommends \
           git openssh-client bash curl tar xz-utils ca-certificates gcc libc6-dev postgresql-17 \
      && rm -rf /var/lib/apt/lists/* \
      && useradd -m -u 1000 -s /bin/bash runner \
      && rm /etc/ssl/certs/ssl-cert-snakeoil.pem /etc/ssl/private/ssl-cert-snakeoil.key /var/cache/ldconfig/aux-cache \
           /var/log/alternatives.log /var/log/apt/history.log /var/log/apt/term.log /var/log/dpkg.log

# forgejo-runner: single static binary, no extraction.
ADD --checksum=sha256:fadaec897f5e6641c363f87ecaf75f866f99c81b7097ec6b433e4c48123fcad1 --chmod=0755 https://code.forgejo.org/forgejo/runner/releases/download/v${FORGEJO_RUNNER_VERSION}/forgejo-runner-${FORGEJO_RUNNER_VERSION}-linux-amd64 /usr/local/bin/forgejo-runner

# buildctl only: the image-build job drives buildkitd on its throwaway VM
# (ruling 110, internal/factoryd/buildvm.go); no docker CLI, no daemon here.
RUN --mount=type=bind,from=downloads,source=/buildkit.tar.gz,target=/tmp/buildkit.tar.gz \
      tar -xzf /tmp/buildkit.tar.gz -C /usr/local bin/buildctl

# crane: image-build copies each image's layer cache from the in-cluster
# build cache into a local OCI layout that buildctl streams to the VM
# (ruling 111).
RUN --mount=type=bind,from=downloads,source=/crane.tar.gz,target=/tmp/crane.tar.gz \
      tar -xzf /tmp/crane.tar.gz -C /usr/local/bin crane

# The Go toolchain, pre-installed so a job never downloads it mid-run: taken
# from the pinned golang base image stage instead of go.dev/dl, which redirects
# to dl.google.com and that host is unreachable here.
COPY --from=go-toolchain /usr/local/go /usr/local/go

# Node 24 (the active LTS line), npm with it: forgejo-runner runs
# JavaScript actions (actions/checkout) with the node on PATH, and the project
# checks run npm scripts.
RUN --mount=type=bind,from=downloads,source=/node.tar.xz,target=/tmp/node.tar.xz \
      tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
      && node --version && npm --version \
      && rm -r /tmp/node-compile-cache

# gosec: pr.yml's static security scan (design decision #6 — chosen over
# govulncheck so the job's egress allowlist never needs vuln.go.dev).
RUN --mount=type=bind,from=downloads,source=/gosec.tar.gz,target=/tmp/gosec.tar.gz \
      tar -xzf /tmp/gosec.tar.gz -C /usr/local/bin gosec

ENV PATH=/usr/local/go/bin:/home/runner/go/bin:$PATH \
    HOME=/home/runner \
    GOPATH=/home/runner/go \
    SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH
USER 1000:1000
WORKDIR /workspace
# Go telemetry off before the first go call: its counter files carry the
# build's date, and `go telemetry off` would date its mode file too; an
# undated "off" is the same mode.
RUN mkdir -p "$HOME/.config/go/telemetry" && printf off > "$HOME/.config/go/telemetry/mode" && /usr/local/go/bin/go version

# The module cache and a warm build cache for the pull-request jobs
# (roadmap 222, item 3), in Go's default places for the runner user: a
# job compiles only what its pull request changed. main CI rebuilds this
# image on every push and the roll pins it, so the cache trails main by
# one roll at most. The module and its package trees are bind-mounted,
# so a change outside them (k8s/, docs) keeps this layer: ci.yml's
# RUNNER_INPUTS name the same paths. Go keys its index of each package
# by the files' mtimes, and a checkout dates them by its own clock: the
# build reads a copy dated at the commit's time and removes it, so no
# layer holds the source.
# Each action entry (*-a) ends in the time it was written, in a 20-wide
# field, and trim.txt holds the last trim's time: both take the commit's
# clock. Go reads an entry's time only to expire cached test results after
# `go clean -testcache`, and -count=1 caches none.
RUN --mount=type=bind,source=go.mod,target=/tmp/warm/go.mod --mount=type=bind,source=go.sum,target=/tmp/warm/go.sum \
      cd /tmp/warm && go mod download
RUN --mount=type=bind,source=go.mod,target=/tmp/src/go.mod --mount=type=bind,source=go.sum,target=/tmp/src/go.sum \
      --mount=type=bind,source=cmd,target=/tmp/src/cmd --mount=type=bind,source=internal,target=/tmp/src/internal \
      --mount=type=bind,source=acceptance,target=/tmp/src/acceptance \
      cp -r /tmp/src /tmp/warm && find /tmp/warm -type f -exec touch -d "@$SOURCE_DATE_EPOCH" {} + \
      && cd /tmp/warm && go build -trimpath -buildvcs=false ./... && go vet ./... && go test -count=1 -run '^$' ./... \
      && cd / && rm -r /tmp/warm \
      && cache=$(go env GOCACHE) \
      && find "$cache" -name '*-a' -exec sed -i -E "s/.{20}\$/$(printf '%20d' "${SOURCE_DATE_EPOCH}000000000")/" {} + \
      && printf %s "$SOURCE_DATE_EPOCH" > "$cache/trim.txt"
ENTRYPOINT ["forgejo-runner"]
