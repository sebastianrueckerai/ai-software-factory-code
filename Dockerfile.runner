ARG FORGEJO_RUNNER_VERSION=13.2.0
ARG BUILDKIT_VERSION=0.33.0
ARG NODE_VERSION=24.21.0
ARG GOSEC_VERSION=2.29.0
ARG CRANE_VERSION=0.22.1
ARG COSIGN_VERSION=3.1.3
ARG GOVULNDB_VERSION=20261021T002729Z

# Every outside image comes from the factory's store by the digest
# upstream-images.txt pins (roadmap 203). A build with no login to the
# store (a local one) passes UPSTREAM= and pulls the same digests from
# their upstreams.
ARG UPSTREAM=git.aisoftwarefactory.world/upstream/
FROM ${UPSTREAM}docker.io/library/golang:1.26.10@sha256:3eca740eb349175cc59f462d409fc324a8239ab3ffdf73d8e63175a041c08b6b AS go-toolchain

# The archives the image unpacks, and cosign for the stage below, each
# read from the factory's store (roadmap 203, step 2): the generic
# package its line of upstream-files.txt fills, at the sha256 the line
# pins — no build reaches the line's upstream. The image's steps mount
# this stage, so no layer of the image keeps an archive.
FROM scratch AS downloads
ARG BUILDKIT_VERSION
ARG CRANE_VERSION
ARG NODE_VERSION
ARG GOSEC_VERSION
ARG COSIGN_VERSION
ARG GOVULNDB_VERSION
ADD --checksum=sha256:b6242896d343100808dcbe37565caf381e0a444a6a83d7255926bb1519248ead https://git.aisoftwarefactory.world/api/packages/upstream/generic/buildkit/v${BUILDKIT_VERSION}/buildkit-v${BUILDKIT_VERSION}.linux-amd64.tar.gz /buildkit.tar.gz
ADD --checksum=sha256:0ab7a1d6932a213aed964ce97666c3077fe691c8606413674a8b3e0b9ec4cda0 https://git.aisoftwarefactory.world/api/packages/upstream/generic/crane/v${CRANE_VERSION}/go-containerregistry_Linux_x86_64.tar.gz /crane.tar.gz
ADD --checksum=sha256:fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6 https://git.aisoftwarefactory.world/api/packages/upstream/generic/node/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz /node.tar.xz
ADD --checksum=sha256:6431b119741c1f4a50fdfcf94e782e16b9e642afc8c7fa9b5d39d48bf3003095 https://git.aisoftwarefactory.world/api/packages/upstream/generic/gosec/v${GOSEC_VERSION}/gosec_${GOSEC_VERSION}_linux_amd64.tar.gz /gosec.tar.gz
ADD --checksum=sha256:4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71 --chmod=0755 https://git.aisoftwarefactory.world/api/packages/upstream/generic/cosign/v${COSIGN_VERSION}/cosign-linux-amd64 /cosign
ADD --checksum=sha256:c500b9aa3de4098cb284af067c6a9070d0d8fdaae641ed1e7dba1d5ce168560b https://git.aisoftwarefactory.world/api/packages/upstream/generic/govulndb/${GOVULNDB_VERSION}/vulndb.zip /vulndb.zip

# cosign alone, which the image does not carry: main CI's image jobs export
# it from here to sign what they push (roadmap 46), and the infra
# repository's scripts/cosign-keygen.sh to make the key pair
FROM scratch AS cosign
COPY --from=downloads /cosign /cosign

FROM ${UPSTREAM}docker.io/library/debian:bookworm-slim@sha256:f3034a6ec3c1205360777c4aae76234998866ad18806ae62b63a3f84ccad782b
LABEL org.opencontainers.image.source=https://git.aisoftwarefactory.world/sf/ai-software-factory-code
# Task 41 (ruling 78/89/90): the untrusted PR runner. Host executor inside
# an unprivileged, gVisor-isolated pod — no docker CLI, no socket, no
# registry or repository credential baked in or mounted. Everything a
# pull_request job needs (a Go + C toolchain — go test -race needs cgo, git,
# Node for JS actions and npm, buildctl to drive the job's build VM, crane to read
# the build cache) ships
# pre-installed so the job itself never has to reach past the egress
# allowlist for tooling.
ARG FORGEJO_RUNNER_VERSION
# roadmap 232: the warm-cache go build below runs on the commit's clock, not
# the build clock (ci.yml passes --build-arg SOURCE_DATE_EPOCH=<commit time>).
# A build that passes none, pr.yml's image check or the nightly, dates the
# warm step at 0: its touch and cache rewrite need a number.
ARG SOURCE_DATE_EPOCH=0

ARG DEBIAN_SNAPSHOT=20261015T000000Z
ARG POSTGRESQL_VERSION=17.11-1.pgdg12+2
ARG LIBPQ_VERSION=18.6-1.pgdg12+2
ARG POSTGRESQL_COMMON_VERSION=293.pgdg12+1
# Debian's packages come from snapshot.debian.org at DEBIAN_SNAPSHOT, so a
# rebuild on a later day installs the same ones (roadmap 242). The snapshot
# is slow at times: apt retries and waits longer, and its old Release files
# are past their Valid-Until by design.
# PostgreSQL 17's server for scripts/pg-test.sh, from the PGDG archive, which
# keeps every version PGDG ever served: apt takes its packages only signed by
# the key of this fingerprint, over HTTPS (the archive serves no HTTP, so
# ca-certificates comes first), and only at the versions named below: the
# archive's pin of 1 leaves apt no candidate there otherwise (its newest
# libpq5 is a beta). The install creates no cluster.
# The install's clocks go with it: ssl-cert (postgresql-common depends on
# it; scripts/pg-test.sh runs its server without TLS) generates a random
# snakeoil pair, and ldconfig's aux-cache and the apt, dpkg and
# alternatives logs carry the build's time.
# The PGDG signing key, the store's copy of its line of
# upstream-files.txt (roadmap 203, step 2) at the line's sha256.
ADD --checksum=sha256:0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76 https://git.aisoftwarefactory.world/api/packages/upstream/generic/pgdg-key/ACCC4CF8/ACCC4CF8.asc /etc/apt/keyrings/pgdg.asc
RUN chmod 0644 /etc/apt/keyrings/pgdg.asc \
      && printf '%s\n' 'Acquire::Retries "8";' 'Acquire::http::Timeout "60";' 'Acquire::https::Timeout "60";' 'Acquire::Check-Valid-Until "false";' \
           > /etc/apt/apt.conf.d/80snapshot \
      && rm /etc/apt/sources.list.d/debian.sources \
      && printf '%s\n' "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" \
           "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-updates main" \
           "deb http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main" > /etc/apt/sources.list \
      && printf '%s\n' 'Package: *' 'Pin: origin apt-archive.postgresql.org' 'Pin-Priority: 1' > /etc/apt/preferences.d/pgdg-archive \
      && mkdir -p /etc/postgresql-common/createcluster.d \
      && echo "create_main_cluster = false" > /etc/postgresql-common/createcluster.d/no-main-cluster.conf \
      && DEBIAN_FRONTEND=noninteractive apt-get update \
      && apt-get install -y --no-install-recommends ca-certificates \
      && echo "deb [signed-by=/etc/apt/keyrings/pgdg.asc,B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8] https://apt-archive.postgresql.org/pub/repos/apt bookworm-pgdg-archive main" \
           > /etc/apt/sources.list.d/pgdg.list \
      && apt-get update \
      && apt-get install -y --no-install-recommends \
           git openssh-client bash curl tar xz-utils unzip ca-certificates gcc libc6-dev \
           postgresql-17=${POSTGRESQL_VERSION} postgresql-client-17=${POSTGRESQL_VERSION} libpq5=${LIBPQ_VERSION} \
           postgresql-common=${POSTGRESQL_COMMON_VERSION} postgresql-client-common=${POSTGRESQL_COMMON_VERSION} \
      && rm -rf /var/lib/apt/lists/* \
      && useradd -m -u 1000 -s /bin/bash runner \
      && rm /etc/ssl/certs/ssl-cert-snakeoil.pem /etc/ssl/private/ssl-cert-snakeoil.key /var/cache/ldconfig/aux-cache \
           /var/log/alternatives.log /var/log/apt/history.log /var/log/apt/term.log /var/log/dpkg.log

# forgejo-runner: single static binary, no extraction. The store's copy
# of its upstream-files.txt line (roadmap 203, step 2), at the line's
# sha256.
ADD --checksum=sha256:fadaec897f5e6641c363f87ecaf75f866f99c81b7097ec6b433e4c48123fcad1 --chmod=0755 https://git.aisoftwarefactory.world/api/packages/upstream/generic/forgejo-runner/v${FORGEJO_RUNNER_VERSION}/forgejo-runner-${FORGEJO_RUNNER_VERSION}-linux-amd64 /usr/local/bin/forgejo-runner

# buildctl only: the image-build job drives buildkitd on its throwaway VM
# (ruling 110, internal/factoryd/buildvm.go); no docker CLI, no daemon here.
RUN --mount=type=bind,from=downloads,source=/buildkit.tar.gz,target=/tmp/buildkit.tar.gz \
      tar -xzf /tmp/buildkit.tar.gz -C /usr/local bin/buildctl

# crane: image-build copies each image's layer cache from the in-cluster
# build cache into a local OCI layout that buildctl streams to the VM
# (ruling 111).
RUN --mount=type=bind,from=downloads,source=/crane.tar.gz,target=/tmp/crane.tar.gz \
      tar -xzf /tmp/crane.tar.gz -C /usr/local/bin crane

# The Go toolchain, pre-installed so a job never downloads it mid-run: taken
# from the pinned golang base image stage instead of go.dev/dl, which redirects
# to dl.google.com and that host is unreachable here.
COPY --from=go-toolchain /usr/local/go /usr/local/go

# Node 24 (the active LTS line), npm with it: forgejo-runner runs
# JavaScript actions (actions/checkout) with the node on PATH, and the project
# checks run npm scripts.
RUN --mount=type=bind,from=downloads,source=/node.tar.xz,target=/tmp/node.tar.xz \
      tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
      && node --version && npm --version \
      && rm -r /tmp/node-compile-cache

# gosec: pr.yml's static security scan (design decision #6).
RUN --mount=type=bind,from=downloads,source=/gosec.tar.gz,target=/tmp/gosec.tar.gz \
      tar -xzf /tmp/gosec.tar.gz -C /usr/local/bin gosec

# govulncheck's database: the store's copy of vuln.go.dev at
# GOVULNDB_VERSION, which pr.yml and ci.yml name with -db, so no job's
# egress needs vuln.go.dev and a commit's verdict holds until the weekly
# upstream card moves the copy. govulncheck is go.mod's tool, which the
# warm step below installs.
RUN --mount=type=bind,from=downloads,source=/vulndb.zip,target=/tmp/vulndb.zip \
      unzip -q /tmp/vulndb.zip -d /usr/local/share/govulndb

ENV PATH=/usr/local/go/bin:/home/runner/go/bin:$PATH \
    HOME=/home/runner \
    GOPATH=/home/runner/go \
    SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH
USER 1000:1000
WORKDIR /workspace
# Go telemetry off before the first go call: its counter files carry the
# build's date, and `go telemetry off` would date its mode file too; an
# undated "off" is the same mode.
RUN mkdir -p "$HOME/.config/go/telemetry" && printf off > "$HOME/.config/go/telemetry/mode" && /usr/local/go/bin/go version

# The module cache and a warm build cache for the pull-request jobs
# (roadmap 222, item 3), in Go's default places for the runner user: a
# job compiles only what its pull request changed. main CI rebuilds this
# image on every push and the roll pins it, so the cache trails main by
# one roll at most. The module cache is the store's go-modules tarball
# of this go.sum (roadmap 203, step 2), in the GOPROXY file layout
# scripts/upstream-files uploads: GOPROXY=off leaves no fallback, so a
# missing or wrong store copy fails the build and go.sum stays the
# content pin, and GOFLAGS=-mod=mod keeps the download a read of the
# cache, not a rewrite of go.mod. The module and its package trees are
# bind-mounted, so a change outside them (k8s/, docs) keeps this layer:
# ci.yml's RUNNER_INPUTS name the same paths. Go keys its index of each
# package by the files' mtimes, and a checkout dates them by its own
# clock: the build reads a copy dated at the commit's time and removes
# it, so no layer holds the source. go.mod's tools (govulncheck) install
# into $GOPATH/bin.
# Each action entry (*-a) ends in the time it was written, in a 20-wide
# field, and trim.txt holds the last trim's time: both take the commit's
# clock. Go reads an entry's time only to expire cached test results after
# `go clean -testcache`, and -count=1 caches none.
# govulncheck moves to /usr/local/bin below: a CI pod mounts an emptyDir
# over /home/runner and its PATH override drops the image's $GOPATH/bin,
# so a tool left there is unreachable in pull-request jobs.
RUN --mount=type=bind,source=go.mod,target=/tmp/warm/go.mod --mount=type=bind,source=go.sum,target=/tmp/warm/go.sum \
      cd /tmp/warm && sum=$(sha256sum go.sum | awk '{print $1}') \
      && curl -fsSL -o /tmp/go-modules.tar.gz "https://git.aisoftwarefactory.world/api/packages/upstream/generic/go-modules/$sum/go-modules.tar.gz" \
      && mkdir -p "$(go env GOMODCACHE)/cache/download" \
      && tar -C "$(go env GOMODCACHE)/cache/download" -xzf /tmp/go-modules.tar.gz \
      && rm /tmp/go-modules.tar.gz \
      && GOPROXY=off GOFLAGS=-mod=mod go mod download
RUN --mount=type=bind,source=go.mod,target=/tmp/src/go.mod --mount=type=bind,source=go.sum,target=/tmp/src/go.sum \
      --mount=type=bind,source=cmd,target=/tmp/src/cmd --mount=type=bind,source=internal,target=/tmp/src/internal \
      --mount=type=bind,source=acceptance,target=/tmp/src/acceptance \
      export GOPROXY=off GOFLAGS=-mod=mod \
      && cp -r /tmp/src /tmp/warm && find /tmp/warm -type f -exec touch -d "@$SOURCE_DATE_EPOCH" {} + \
      && cd /tmp/warm && go build -trimpath -buildvcs=false ./... && go vet ./... && go test -count=1 -run '^$' ./... \
      && go install -trimpath tool \
      && cd / && rm -r /tmp/warm \
      && cache=$(go env GOCACHE) \
      && find "$cache" -name '*-a' -exec sed -i -E "s/.{20}\$/$(printf '%20d' "${SOURCE_DATE_EPOCH}000000000")/" {} + \
      && printf %s "$SOURCE_DATE_EPOCH" > "$cache/trim.txt"
USER root
RUN cp /home/runner/go/bin/govulncheck /usr/local/bin/govulncheck
USER 1000:1000
ENTRYPOINT ["forgejo-runner"]
