FROM golang:1.25.9@sha256:8a7adc288b77e9b787cd2695029eb54d10ae80571b21d44fed68d067ad0a9c96 AS go-toolchain

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
LABEL org.opencontainers.image.source=https://git.aisoftwarefactory.world/sf/ai-software-factory-code
# Task 41 (ruling 78/89/90): the untrusted PR runner. Host executor inside
# an unprivileged, gVisor-isolated pod — no docker CLI, no socket, no
# registry or repository credential baked in or mounted. Everything a
# pull_request job needs (a Go + C toolchain — go test -race needs cgo, git,
# Node for JS actions and npm, buildctl to drive the job's build VM, crane to read
# the build cache) ships
# pre-installed so the job itself never has to reach past the egress
# allowlist for tooling.
ARG FORGEJO_RUNNER_VERSION=13.2.0
ARG BUILDKIT_VERSION=0.33.0
ARG GO_VERSION=1.25.9
ARG NODE_VERSION=24.21.0
ARG GOSEC_VERSION=2.29.0
ARG CRANE_VERSION=0.22.1

# PostgreSQL 17's server for scripts/pg-test.sh, from the PGDG repository:
# apt takes its packages only signed by the key of this fingerprint, and the
# install creates no cluster.
ADD https://www.postgresql.org/media/keys/ACCC4CF8.asc /etc/apt/keyrings/pgdg.asc
RUN chmod 0644 /etc/apt/keyrings/pgdg.asc \
      && echo "deb [signed-by=/etc/apt/keyrings/pgdg.asc,B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
           > /etc/apt/sources.list.d/pgdg.list \
      && mkdir -p /etc/postgresql-common/createcluster.d \
      && echo "create_main_cluster = false" > /etc/postgresql-common/createcluster.d/no-main-cluster.conf \
      && DEBIAN_FRONTEND=noninteractive apt-get update \
      && apt-get install -y --no-install-recommends \
           git openssh-client bash curl tar xz-utils ca-certificates gcc libc6-dev postgresql-17 \
      && rm -rf /var/lib/apt/lists/* \
      && useradd -m -u 1000 -s /bin/bash runner

# forgejo-runner: single static binary, no extraction.
ADD https://code.forgejo.org/forgejo/runner/releases/download/v${FORGEJO_RUNNER_VERSION}/forgejo-runner-${FORGEJO_RUNNER_VERSION}-linux-amd64 /usr/local/bin/forgejo-runner
RUN echo "fadaec897f5e6641c363f87ecaf75f866f99c81b7097ec6b433e4c48123fcad1  /usr/local/bin/forgejo-runner" | sha256sum -c - \
      && chmod 0755 /usr/local/bin/forgejo-runner

# buildctl only: the image-build job drives buildkitd on its throwaway VM
# (ruling 110, internal/factoryd/buildvm.go); no docker CLI, no daemon here.
ADD https://github.com/moby/buildkit/releases/download/v${BUILDKIT_VERSION}/buildkit-v${BUILDKIT_VERSION}.linux-amd64.tar.gz /tmp/buildkit.tar.gz
RUN echo "b6242896d343100808dcbe37565caf381e0a444a6a83d7255926bb1519248ead  /tmp/buildkit.tar.gz" | sha256sum -c - \
      && tar -xzf /tmp/buildkit.tar.gz -C /usr/local bin/buildctl \
      && rm /tmp/buildkit.tar.gz

# crane: image-build copies each image's layer cache from the in-cluster
# build cache into a local OCI layout that buildctl streams to the VM
# (ruling 111).
ADD https://github.com/google/go-containerregistry/releases/download/v${CRANE_VERSION}/go-containerregistry_Linux_x86_64.tar.gz /tmp/crane.tar.gz
RUN echo "0ab7a1d6932a213aed964ce97666c3077fe691c8606413674a8b3e0b9ec4cda0  /tmp/crane.tar.gz" | sha256sum -c - \
      && tar -xzf /tmp/crane.tar.gz -C /usr/local/bin crane \
      && rm /tmp/crane.tar.gz

# Go 1.25 toolchain, pre-installed so a job never downloads it mid-run: taken
# from the pinned golang base image stage instead of go.dev/dl, which redirects
# to dl.google.com and that host is unreachable here.
COPY --from=go-toolchain /usr/local/go /usr/local/go

# Node 24 (the active LTS line), npm with it: forgejo-runner runs
# JavaScript actions (actions/checkout) with the node on PATH, and the project
# checks run npm scripts. The sha256 is the tarball's line in nodejs.org's signed
# SHASUMS256.txt for this version. One layer: no image keeps the archive.
RUN curl -fsSL -o /tmp/node.tar.xz https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz \
      && echo "fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6  /tmp/node.tar.xz" | sha256sum -c - \
      && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
      && rm /tmp/node.tar.xz \
      && node --version && npm --version \
      && rm -r /tmp/node-compile-cache

# gosec: pr.yml's static security scan (design decision #6 — chosen over
# govulncheck so the job's egress allowlist never needs vuln.go.dev).
ADD https://github.com/securego/gosec/releases/download/v${GOSEC_VERSION}/gosec_${GOSEC_VERSION}_linux_amd64.tar.gz /tmp/gosec.tar.gz
RUN echo "6431b119741c1f4a50fdfcf94e782e16b9e642afc8c7fa9b5d39d48bf3003095  /tmp/gosec.tar.gz" | sha256sum -c - \
      && tar -xzf /tmp/gosec.tar.gz -C /usr/local/bin gosec \
      && rm /tmp/gosec.tar.gz

ENV PATH=/usr/local/go/bin:/home/runner/go/bin:$PATH \
    HOME=/home/runner \
    GOPATH=/home/runner/go
USER 1000:1000
WORKDIR /workspace
RUN /usr/local/go/bin/go version

# The module cache and a warm build cache for the pull-request jobs
# (roadmap 222, item 3), in Go's default places for the runner user: a
# job compiles only what its pull request changed. main CI rebuilds this
# image on every push and the roll pins it, so the cache trails main by
# one roll at most. The source leaves the image; the caches stay.
COPY --chown=1000:1000 go.mod go.sum /tmp/warm/
RUN cd /tmp/warm && go mod download
COPY --chown=1000:1000 . /tmp/warm/
RUN cd /tmp/warm && go build ./... && go vet ./... && go test -count=1 -run '^$' ./... && rm -r /tmp/warm
ENTRYPOINT ["forgejo-runner"]
