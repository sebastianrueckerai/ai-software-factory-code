{
  "alert": "factory-gateway roll not live for 10 minutes",
  "alertType": "METRIC_BASED_ALERT",
  "description": "A ReplicaSet of the Deployment factory-gateway has had fewer available replicas than desired for all of the last 10 minutes (k8s-infra's k8s.replicaset.desired and k8s.replicaset.available): a roll whose new pod never became ready, or a pod that stopped. The ReplicaSet, not the Deployment: the gateway's rolling update keeps the old pod available, so the Deployment's own counts show nothing. The merge is within a minute of the rollout's start (Flux's interval).",
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5",
  "disabled": false,
  "labels": {"severity": "critical", "service": "factory-gateway"},
  "annotations": {"summary": "replicas desired but not available"},
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {"type": "builder_query", "spec": {"name": "A", "signal": "metrics", "stepInterval": 60,
          "aggregations": [{"metricName": "k8s.replicaset.desired", "timeAggregation": "latest", "spaceAggregation": "sum"}],
          "groupBy": [{"name": "k8s.replicaset.name", "fieldContext": "resource", "fieldDataType": "string"}],
          "filter": {"expression": "k8s.replicaset.name LIKE 'factory-gateway-%'"}}},
        {"type": "builder_query", "spec": {"name": "B", "signal": "metrics", "stepInterval": 60,
          "aggregations": [{"metricName": "k8s.replicaset.available", "timeAggregation": "latest", "spaceAggregation": "sum"}],
          "groupBy": [{"name": "k8s.replicaset.name", "fieldContext": "resource", "fieldDataType": "string"}],
          "filter": {"expression": "k8s.replicaset.name LIKE 'factory-gateway-%'"}}},
        {"type": "builder_formula", "spec": {"name": "F1", "expression": "A - B"}}
      ]
    },
    "selectedQueryName": "F1",
    "thresholds": {"kind": "basic", "spec": [
      {"name": "critical", "target": 0, "targetUnit": "", "recoveryTarget": null, "matchType": "2", "op": "1", "channels": []}
    ]}
  },
  "evaluation": {"kind": "rolling", "spec": {"evalWindow": "10m", "frequency": "1m"}},
  "notificationSettings": {"usePolicy": false}
}
