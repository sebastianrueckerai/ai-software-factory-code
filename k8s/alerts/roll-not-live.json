{
  "alert": "roll not live within 10 minutes of its merge",
  "alertType": "METRIC_BASED_ALERT",
  "description": "A Deployment of the newest k8s/ commit on main is still not live on it more than 10 minutes after the roll watcher saw the commit, its merge (factoryd's factory.roll.pending). A Deployment metric cannot tell: a stuck rolling update keeps the old pod available.",
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5",
  "disabled": false,
  "labels": {"severity": "critical"},
  "annotations": {"summary": "seconds since the merge, the Deployment not live on it"},
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {"type": "builder_query", "spec": {"name": "A", "signal": "metrics", "stepInterval": 60,
          "aggregations": [{"metricName": "factory.roll.pending", "timeAggregation": "latest", "spaceAggregation": "max"}],
          "groupBy": [{"name": "deployment", "fieldContext": "attribute", "fieldDataType": "string"}],
          "filter": {"expression": "service.name = 'factoryd'"}}}
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {"kind": "basic", "spec": [
      {"name": "critical", "target": 600, "targetUnit": "", "recoveryTarget": null, "matchType": "1", "op": "1", "channels": []}
    ]}
  },
  "evaluation": {"kind": "rolling", "spec": {"evalWindow": "5m", "frequency": "1m"}},
  "notificationSettings": {"usePolicy": false}
}
